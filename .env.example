# ============================================================
# Environment variables — reference only
# ============================================================
# This app is plain static HTML/CSS/JS (no build step — see
# ARCHITECTURE_PLAN.md for why). A static file served directly to a
# browser cannot read a .env file at all; there is no build-time or
# server-time substitution step. So this file documents two different
# things, split clearly below — copy it to `.env` for any *tooling*
# that runs on your machine (seed scripts, future CLI use), but do NOT
# expect the website itself to read it.
#
# Never commit a real `.env` — it's already in .gitignore.
# ============================================================

# ---- PUBLIC values (safe in client code) ----------------------------
# These are hardcoded directly in assets/js/supabase-client.js, exactly
# the same way the existing index-1.html hardcodes its Firebase client
# config. They are NOT secrets — Supabase's publishable/anon key is
# designed to be shipped to browsers; real protection comes from Row
# Level Security (see SECURITY.md), not from hiding this value.
SUPABASE_URL=https://woedykgrzczgogtymfxg.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_TN-SovfsBqnVV3laPT9HJw_SKzMryrU

# Cloudinary is unchanged from the existing app (AUDIT.md §15) — cloud
# name + unsigned upload preset are already public/client-embedded today.
CLOUDINARY_CLOUD_NAME=dm8jiomy3
CLOUDINARY_UPLOAD_PRESET=metro_reports

# ---- SECRET values (server-side / Edge Functions ONLY — never in any
# file the browser loads) ----------------------------------------------
# Leave blank here; set real values via `supabase secrets set` or the
# Supabase dashboard's Edge Function secrets, never in a committed file.
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if/when Razorpay online payments are enabled in production
# and signature verification moves server-side (see BACKEND_DEPENDENCIES.md §6).
RAZORPAY_KEY_SECRET=
